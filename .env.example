# ─── Chat 模型（同 V10）──────────────────────────────────────────────
OPENAI_API_KEY=sk-your-deepseek-key-here
OPENAI_BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

# ─── V10：外部记忆服务开关 ────────────────────────────────────────────
# 不设：agent 只挂 builtin provider（行为同 V9）
# 设了：agent 会注册 RemoteSemanticProvider，启动时探 /healthz
# MEMORY_SERVICE_URL=http://127.0.0.1:8765
# MEMORY_SESSION_ID=default

# ─── V10.1：Postgres + pgvector（mock server 端用）────────────────────
# 与 docker-compose.yml 对齐，本地起 docker 后开箱即可
DATABASE_URL=postgresql://nano:nano@127.0.0.1:5432/nano_memory

# ─── V10.1：Embedding 端点（mock server 端用，OpenAI 范式）──────────
# 任何 OpenAI 兼容端点都行：OpenAI、SiliconFlow、DashScope、本地 vLLM/llama.cpp、Ollama 等。
# 未设时回退到 OPENAI_API_KEY / OPENAI_BASE_URL —— DeepSeek 不提供 embedding，
# 用 DeepSeek chat 时建议单独配一个 embedding 端点。
# EMBEDDING_API_KEY=sk-your-embedding-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
#
# ⚠️ EMBEDDING_DIM 必须与 scripts/init.sql 里的 VECTOR(N) 完全一致 ⚠️
# 常见模型默认维度（换模型时同步改两边）：
#   text-embedding-3-small      → 1536
#   text-embedding-3-large      → 3072
#   DashScope text-embedding-v3 → 1024
#   BGE / bge-large-zh-v1.5     → 1024
#   Ollama nomic-embed-text     → 768
# 改维度的步骤：
#   1) 同步改 .env 的 EMBEDDING_DIM 与 scripts/init.sql 的 VECTOR(N)
#   2) docker compose down -v   # 删卷，让 init.sql 下次重跑
#   3) docker compose up -d
# mock server 启动时会自检：DB 列维度 ≠ EMBEDDING_DIM 就 fail-fast，不会让你
# 跑到 /sync 才报 500。
