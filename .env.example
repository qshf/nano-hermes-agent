# ─── Chat 模型（同 V10）──────────────────────────────────────────────
OPENAI_API_KEY=sk-your-deepseek-key-here
OPENAI_BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

# ─── V18：Transport 路由 ─────────────────────────────────────────────
# chat_completions（默认）：走 OpenAI 兼容端点（DeepSeek/SiliconFlow/...）
# anthropic_messages：走 Anthropic Messages API（DashScope Qwen 等）
# TRANSPORT_MODE=chat_completions
#
# Anthropic 模式必填（DashScope Qwen 示例）：
ANTHROPIC_API_KEY=sk-your-dashscope-key
ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
MODEL=qwen3.6-plus

# ─── V19：故障切换链 + 断路器 ────────────────────────────────────────
# 不设：行为同 V18，使用 TRANSPORT_MODE 单家
# 设了：按逗号分隔的顺序组成主备链，主家挂自动切备家
#
# 链段语法：api_mode[:model]
#   chat_completions:deepseek-chat       → 用 DeepSeek 端点 + deepseek-chat 模型
#   anthropic_messages:qwen3.6-plus      → 用 Anthropic 端点 + qwen3.6-plus 模型
#   chat_completions                     → 不内联 model，回退到全局 MODEL env
#
# 仿源项目 hermes-agent run_agent.py:1742-1765 fallback chain 设计 —
# 每条 entry 自包含 model，避免"主家是 DeepSeek 但 MODEL=qwen3.6-plus"这种错配。
# TRANSPORT_CHAIN=chat_completions:deepseek-chat,anthropic_messages:qwen3.6-plus
# FAILOVER_FAILURE_THRESHOLD=3        # 连续失败几次后断路器打开（默认 3）
# FAILOVER_COOLDOWN_SECONDS=60        # 断路器冷却时间（默认 60s）
# FAILOVER_MAX_RETRIES=2              # 单 transport RETRYABLE 错误最大重试次数（默认 2）
# FAILOVER_BASE_DELAY=1.0             # backoff 基数（实际延迟 = base * 2^attempt + jitter）

# ─── V27.1：外部 Voice Orchestrator（host 只发送事实，不做播报策略）────────
# 前置：外部 voice-orchestrator / nano_voice_kit Runtime 自行启动；主 agent 不调用 nano-voice-say。
DASHSCOPE_API_KEY=sk-your-dashscope-key
VOICE_ORCHESTRATOR_ENABLED=0
VOICE_ORCHESTRATOR_URL=http://127.0.0.1:8766/v1/turn-events
VOICE_ORCHESTRATOR_TIMEOUT_SECONDS=0.5
VOICE_ORCHESTRATOR_QUEUE_SIZE=128
# 第一版只承诺流式路径的细粒度 phase activity；非流式只保守静默。
VOICE_ORCHESTRATOR_STREAM_ONLY=1
# envelope 预览边界：默认截断/脱敏，不发送 raw args/output/文件内容/系统 prompt/CoT。
VOICE_ORCHESTRATOR_MAX_MESSAGE_PREVIEWS=4
VOICE_ORCHESTRATOR_MAX_MESSAGE_CHARS=800
VOICE_ORCHESTRATOR_MAX_TOOL_RESULT_CHARS=1200
VOICE_ORCHESTRATOR_SEND_MESSAGE_PREVIEW=1
VOICE_ORCHESTRATOR_SEND_TOOL_PREVIEW=1
# 流式工具参数节流：每积累 N 字符才发一次 phase_activity（默认 512，0 = 每 delta 都发）
VOICE_ORCHESTRATOR_ARGUMENT_DELTA_MIN_CHARS=512
# 每轮最多播报次数（默认 12，复杂任务可调高）
VOICE_ORCHESTRATOR_MAX_SPOKEN_IN_TURN=12

# ─── V11：外部记忆服务开关 ────────────────────────────────────────────
# 不设：agent 只挂 builtin provider（行为同 V9）
# 设了：agent 会注册 RemoteSemanticProvider，启动时探 /healthz
MEMORY_SERVICE_URL=http://127.0.0.1:8765
MEMORY_SESSION_ID=default

# ─── V11：Memory Mode（Hindsight 三种模式）────────────────────────────
# context: 纯 prefetch 注入（模型不感知记忆工具）
# tools:   暴露 hindsight_retain/recall/reflect 工具（模型主动调用）
# hybrid:  两者并存（自动 prefetch + 模型可主动调用）
MEMORY_MODE=hybrid

# Prefetch 方式：recall（返回 hit 列表）或 reflect（LLM 合成回答）
MEMORY_PREFETCH_METHOD=recall

# Bank ID — 命名空间隔离（对应 Hindsight 的 bank 概念）
MEMORY_BANK_ID=hermes

# 召回广度：low=2, mid=5, high=10
MEMORY_RECALL_BUDGET=mid

# 自动 retain（每轮结束后自动调 /retain）：1 开启，0 关闭
MEMORY_AUTO_RETAIN=1

# 自动 recall（每轮开始前自动 prefetch）：1 开启，0 关闭
MEMORY_AUTO_RECALL=1

# 自动 retain 时附加的 tags（逗号分隔）
# MEMORY_RETAIN_TAGS=conversation,auto

# ─── V11：Postgres + pgvector（mock server 端用）────────────────────
# 与 docker-compose.yml 对齐
DATABASE_URL=postgresql://nano:nano@127.0.0.1:5432/nano_memory

# ─── V11：Embedding 端点（mock server 端用，OpenAI 范式）──────────
# 任何 OpenAI 兼容端点都行：OpenAI、SiliconFlow、DashScope、本地 vLLM 等。
# 未设时回退到 OPENAI_API_KEY / OPENAI_BASE_URL。
EMBEDDING_API_KEY=sk-your-embedding-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3
EMBEDDING_DIM=1024
#
# ⚠️ EMBEDDING_DIM 必须与 scripts/init.sql 里的 VECTOR(N) 完全一致 ⚠️
# 常见模型默认维度（换模型时同步改两边）：
#   text-embedding-3-small      → 1536
#   text-embedding-3-large      → 3072
#   DashScope text-embedding-v3 → 1024
#   BGE / bge-large-zh-v1.5     → 1024
#   Ollama nomic-embed-text     → 768
# 改维度的步骤：
#   1) 同步改 .env 的 EMBEDDING_DIM 与 scripts/init.sql 的 VECTOR(N)
#   2) docker compose down -v
#   3) docker compose up -d

# ─── V11：事实去重阈值（mock server 端用）────────────────────────────
# 同实体下新 fact 与已有 fact 余弦相似度超过此值时 UPDATE 而非 INSERT
# FACT_DEDUP_THRESHOLD=0.92
